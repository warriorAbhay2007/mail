# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional SMTP delivery configuration (falls back to local outbox persistence if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Supabase JWT secret for verifying Supabase Auth bearer tokens
SUPABASE_JWT_SECRET=

# Optional MongoDB connection string (defaults to local persistent store in ./data)
MONGODB_URI=
